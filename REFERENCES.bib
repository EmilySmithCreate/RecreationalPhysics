@inproceedings{VL05,
  author  = {Viger, Fabien and Latapy, Matthieu},
  title   = {Efficient and simple generation of random simple connected graphs with prescribed degree sequence},
  year    = {2005},
  note    = {unread; bibliographic details to verify. **DECISION AFTER READING, 2026-09-21: do not implement this.** Its abstract was read; the full text was not, and does not need to be. It solves a different problem -- generating graphs uniformly *from scratch* for arbitrary real-world degree sequences -- and its contribution is efficiency at large sparse sizes, not correctness. For an MCMC that is already running, Taylor81 makes the simple approach correct, so the clever machinery buys nothing here. Original note follows. **This is the algorithm, and it is the thing to read, not the papers citing it.** [GV21] uses degree-preserving link swaps citing this work, and its connectivity-preserving variant is what produces its Fig. 7 (a closed chain of hypercubes under a connectedness constraint). The owner's reading notes record that GV21 does not give the details, so the details have to come from here. **We have no connectivity-preserving move.** Needed for: the Gate A re-run against GV21 Figs. 3B and 7; and T11, where the question is whether the half-converted state contains a connected geometric region. NOT needed for T6, which samples the whole state space including disconnected configurations.}
}

@incollection{Taylor81,
  author    = {Taylor, Richard},
  title     = {Constrained switchings in graphs},
  booktitle = {Combinatorial Mathematics VIII},
  series    = {Lecture Notes in Mathematics},
  publisher = {Springer},
  year      = {1981},
  note      = {**Secondary; the statement below is quoted from several sources that cite it, not read in the original -- verify before relying on it.** The theorem that settles how to sample connected graphs: any connected graph can be turned into any other connected graph of the same degree sequence by a sequence of edge switchings **with every intermediate graph also connected**, for simple graphs, multigraphs and pseudographs. Consequence for us: "switch, and reject the move if it disconnects the graph" is an irreducible chain on connected graphs, and detailed balance is automatic because a restricted state space with a symmetric proposal is still detailed-balanced. **So no special machinery is needed for correctness.** What the theorem does NOT cover is our extra hard-core constraint; see the next entry, which shows that added constraints can break exactly this property.}
}

@article{Swap17,
  title   = {Swap connectivity for two graph spaces between simple and pseudo graphs, and disconnectivity for triangle constraints},
  year    = {2017},
  eprint  = {1704.01951},
  archivePrefix = {arXiv},
  note    = {unread; found 2026-09-21; authors not looked up. **The reason the empirical check below is not optional.** Its title states that swap connectivity, which Taylor81 guarantees for plain degree-constrained spaces, **fails once a triangle constraint is added.** Our space carries a hard-core constraint (no two points sharing more than two neighbours) on top of connectedness, so Taylor's guarantee does not automatically extend to it. Read before any connected run is interpreted.}
}

@article{RdF15,
  author  = {Rindlisbacher, Tobias and de Forcrand, Philippe},
  title   = {Euclidean Dynamical Triangulation revisited: is the phase transition really 1st order?},
  year    = {2015},
  eprint  = {1503.03706},
  archivePrefix = {arXiv},
  note    = {**Read in part (abstract, Secs. 1, 2.2-2.4) on 2026-09-21; supplied by the owner from her own reading folder as `docs/reading/Euclidian Dynamical triangulation revisited 2021.pdf`.** The filename says 2021 and the title page carries a 2021 compile date, but the arXiv stamp on the PDF is 1503.03706v2, 10 June 2015 -- **verify which before citing a year.** This is the most directly useful methodological source found for T6, for five reasons. (1) **The same historical arc as ours, in a neighbouring model:** the 4D EDT transition "was long believed to be of second order until in 1996 first order behavior was found for sufficiently large systems", and this paper confirms first order up to 64k simplices. That is the finite-size argument of this project, already played out elsewhere. (2) **They beat critical slowing down with parallel tempering, not with flat-histogram sampling**, using the same swap rule `tempering.py` implements. (3) **The reason a plain chain cannot do it, stated cleanly:** at a first-order transition the correlation length stays finite, but the autocorrelation time diverges anyway because transitions between the two coexisting phases become *exponentially suppressed with increasing system size*. (4) **A warning about soft constraints:** earlier work controlled the volume with a harmonic potential, which "introduces a systematic error for all moves which change N4"; they use an infinite potential well instead. Our (S, X) window is the same kind of device and the same caution applies. They also take measurements after a fixed number of *attempted* rather than accepted moves, calling the latter a systematic error -- our sweep is already 2N attempts, so we comply. (5) **They have our ergodicity problem and say so:** "there is no set of ergodic moves known for the space of triangulations of fixed N4", so they run quasi-canonically. Useful precedent for how to report Q16 honestly. **And one thing that bears directly on T10:** they close by proposing "a class of modified path-integral measures that might remove the metastability of the Markov chain and turn the phase transition into 2nd order". A change of *measure* changing the *order* of the transition is exactly what the labelled-versus-interchangeable question asks, published, in a neighbouring model.}
}

