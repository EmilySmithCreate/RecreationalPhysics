  note    = {**Abstract read directly (2026-09-21); full text not read.** Submitted 17 November 2025, so the most recent thing in this bibliography. An independent model: connected graphs under a Hamiltonian coupling algebraic connectivity, Ollivier-Ricci curvature and an edge-density penalty, explored by "connected simulated annealing". **Three reasons to read it.** (a) It does finite-size scaling and reports spectral dimension growing with size towards about 4 and Hausdorff dimension towards about 3 -- which is methodology for exactly the measurement this project has not yet made. (b) Its Hamiltonian contains a *connectivity* term and its sampler is described as connected, which is the machinery Gate A's re-run needs and which we do not have. **Read this and [VL05] BEFORE designing any connectivity-preserving move**, rather than building one and discovering afterwards that two groups already did it better. (c) It does not cite Trugenberger's programme at all, which is worth knowing about the state of the field. Author single; affiliation and venue not checked.}
}

@inproceedings{VL05,
  author  = {Viger, Fabien and Latapy, Matthieu},
  title   = {Efficient and simple generation of random simple connected graphs with prescribed degree sequence},
  year    = {2005},
  note    = {unread; bibliographic details to verify. **DECISION AFTER READING, 2026-09-21: do not implement this.** Its abstract was read; the full text was not, and does not need to be. It solves a different problem -- generating graphs uniformly *from scratch* for arbitrary real-world degree sequences -- and its contribution is efficiency at large sparse sizes, not correctness. For an MCMC that is already running, Taylor81 makes the simple approach correct, so the clever machinery buys nothing here. Original note follows. **This is the algorithm, and it is the thing to read, not the papers citing it.** [GV21] uses degree-preserving link swaps citing this work, and its connectivity-preserving variant is what produces its Fig. 7 (a closed chain of hypercubes under a connectedness constraint). The owner's reading notes record that GV21 does not give the details, so the details have to come from here. **We have no connectivity-preserving move.** Needed for: the Gate A re-run against GV21 Figs. 3B and 7; and T11, where the question is whether the half-converted state contains a connected geometric region. NOT needed for T6, which samples the whole state space including disconnected configurations.}
}

@incollection{Taylor81,
  author    = {Taylor, Richard},
  title     = {Constrained switchings in graphs},
  booktitle = {Combinatorial Mathematics VIII},
  series    = {Lecture Notes in Mathematics},
  publisher = {Springer},
  year      = {1981},
  note      = {**Secondary; the statement below is quoted from several sources that cite it, not read in the original -- verify before relying on it.** The theorem that settles how to sample connected graphs: any connected graph can be turned into any other connected graph of the same degree sequence by a sequence of edge switchings **with every intermediate graph also connected**, for simple graphs, multigraphs and pseudographs. Consequence for us: "switch, and reject the move if it disconnects the graph" is an irreducible chain on connected graphs, and detailed balance is automatic because a restricted state space with a symmetric proposal is still detailed-balanced. **So no special machinery is needed for correctness.** What the theorem does NOT cover is our extra hard-core constraint; see the next entry, which shows that added constraints can break exactly this property.}
}

