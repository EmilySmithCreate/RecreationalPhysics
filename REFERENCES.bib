@article{BP00,
  author  = {Bousso, Raphael and Polchinski, Joseph},
  title   = {Quantization of four-form fluxes and dynamical neutralization of the cosmological constant},
  year    = {2000},
  note    = {unread; from general knowledge, bibliographic details to verify. The standard entry point to the "landscape": an enormous number of stable settings of the dials, with transitions between them proceeding by bubble nucleation, which is to say by first-order changes of exactly the kind VISION claim 4 describes. Relevant as precedent and as machinery -- and as a caution, since the framework assumes a spacetime with dimensions already in it and so cannot answer where geometry comes from.}
}

@article{Carlip17,
  author  = {Carlip, Steven},
  title   = {Dimension and dimensional reduction in quantum gravity},
  year    = {2017},
  note    = {unread; from general knowledge, year and title to verify. A review rather than a single result, which is why it is worth the time: several unrelated approaches to quantum gravity converge on an effective dimension falling towards about 2 at short distances. Bears directly on whether "how many dimensions" is a quantity that can change with scale, which VISION's dimension ladder assumes it is. **Why it matters beyond bookkeeping** (ours, unverified, from general knowledge): the gravitational coupling has dimensions of length^(d-2), so it is dimensionless at d = 2 and carries units of area at d = 4 -- and it is that dimensionful coupling which makes general relativity non-renormalisable. If the effective dimension really falls to 2 at short distances, the obstruction disappears exactly where it bites. That is the usual motivation for caring about this result, and it is also the reason a two-dimensional starting point may be less arbitrary than it looks. Neither [T25] nor [KTB19] makes that connection in what we have read; one for the letter.}
}

@article{AJL05,
  author  = {Ambj{\o}rn, Jan and Jurkiewicz, Jerzy and Loll, Renate},
  title   = {The spectral dimension of the universe},
  year    = {2005},
  note    = {unread; from general knowledge, details to verify. Causal dynamical triangulations: a serious competitor route to emergent geometry in which the measured dimension runs from about 4 at large scales to about 2 at small ones. Two reasons to record it. VISION's survey of alternatives does not currently mention it, which is a gap; and its main observable, the dimension a random walker feels, is one this project already plans to measure.}
}
