@article{Gorard20,
  author  = {Gorard, Jonathan},
  title   = {Some quantum mechanical properties of the Wolfram model},
  journal = {Complex Systems},
  volume  = {29},
  number  = {2},
  year    = {2020},
  pages   = {537--598},
  note    = {Read in part on 2026-09-23 (Sections 2.2, 2.3, the signature argument on pp. 566--567, and the Bell subsection on pp. 587--588, from the text of the publisher's PDF; local copy in docs/reading/). A multiway system runs every rewriting order at once; branches are read as orthonormal eigenstates and a "branchlike hypersurface" as their superposition (eq. 25). The amplitudes are not derived from counting branches: they are "concretely specified by a sum of the incoming path weights", computed with a "discrete multiway norm" whose complex signature is argued from the need for three distinct signs in the metric of the multiway causal graph (p. 567), so the phase enters through the norm. The Born rule is imposed as the square of that amplitude (eq. 29, "the multiway Born rule"). Bell is met by making the theory explicitly non-local across branches, "in much the same way as ... de Broglie--Bohm" (p. 588). For us: the closest cousin of "every version at once" puts the phase in by hand and escapes Bell by non-locality; it does not get either from counting.}
}

@article{Hardy01,
  author  = {Hardy, Lucien},
  title   = {Quantum theory from five reasonable axioms},
  year    = {2001},
  eprint  = {quant-ph/0101012},
  archivePrefix = {arXiv},
  note    = {Read in part on 2026-09-23 (the abstract and the five axioms, from the ar5iv rendering; local PDF in docs/reading/). Axioms 1--4 (probabilities, simplicity, subspaces, composite systems) hold for both classical probability and quantum theory and give K = N^r for the number of degrees of freedom against the number of distinguishable states. Axiom 5, "there exists a continuous reversible transformation on a system between any two pure states", rules out the classical case (K = N, finitely many pure states, nothing continuous between them) and forces K = N^2, the complex Hilbert space; drop axiom 5, or only the word "continuous", and classical probability returns. For us: the one ingredient that separates counting versions from quantum mechanics has a name, and discrete renamings do not have it. Unpublished preprint as far as we know; to verify.}
}

@article{Smolin06,
  author  = {Smolin, Lee},
  title   = {The status of cosmological natural selection},
  year    = {2006},
  eprint  = {hep-th/0612185},
  archivePrefix = {arXiv},
  note    = {**Read 2026-09-23 from the arXiv HTML, text searched directly: abstract, Secs. 1 to 3 in full, Sec. 4.1 and 4.2.1 to 4.2.3; the rest of Sec. 4 (the reply to Vilenkin) skimmed.** Journal reference not checked. The hypotheses (Sec. 2.2): black-hole singularities bounce into new expanding universes; each birth changes the low-energy parameters by a small random step; so the fitness of a set of parameters is the average number of black holes a universe with them makes. **Master prediction:** almost no small change of our parameters increases the number of black holes. **Three published predictions (Sec. 3.2):** neutron stars are kaon-condensate stars with an upper mass limit near 1.6 solar masses; inflation, if true, is single-parameter, so the fluctuation size and the number of e-folds are anti-correlated; little early massive-star formation. *Ours, from general knowledge, to verify before any use:* neutron stars of about 2 solar masses were measured after this review (from 2010), which would count against the first prediction. **Why it is here:** the owner's cosmology (docs/parked/extension_2026-09-22.md) is a cousin: new spacetimes born where black holes collide rather than inside each one, with λ > 1 needed for any lump. The local file docs/reading/smolin_cosmological_natural_selection.html is NOT this paper: it is a note written from general knowledge by an earlier session, and says so.}
}

@article{Smolin11,
  author  = {Smolin, Lee},
  title   = {A real ensemble interpretation of quantum mechanics},
  year    = {2011},
  eprint  = {1104.2822},
  archivePrefix = {arXiv},
  note    = {**Read in full 2026-09-23 from the arXiv HTML** (equations followed in outline, not re-derived). Journal reference to verify (from memory, Foundations of Physics, 2012). A quantum state describes a REAL ensemble: all the similarly prepared copies of a small system in the universe. Probabilities are relative frequencies in it. Each copy carries two "beables": the value of an observable and a PHASE. Copies evolve by a stochastic copy rule (system I takes on the beables of system J, at a rate that depends on how many copies hold each value and on their phase difference, not on where they are) plus a continuous phase evolution; with the rates chosen, the ensemble frequencies obey the Schrödinger equation (Sec. III). **Macroscopic systems are classical because they have no copies anywhere** ("a member of an ensemble of one"). Non-local by construction, which is how it escapes Bell. **Predicted departures from quantum mechanics** for systems in states with few copies in the universe (Secs. VI, VII); the "nodes" problem (a value with zero copies can never be copied into) is his most serious open issue. **Why it matters here (ours, unverified):** it is the closest published relative found so far of VISION Update 17. Shared: probabilities as counts of real versions; classicality as having one version, which T15 rung 0 found for the melt and for a world with three different defects (O28). Different, and exactly where our rungs failed: his versions INTERACT through a copy dynamics, which is what escapes Bell (our fixed-arrangement counting cannot, O29); and he puts in a phase per copy by hand, the same missing ingredient the amplitude-rule brief names (Hardy's fifth axiom). His closing remark bears on the owner's "every arrangement exists forever": if the universe held exact copies of macroscopic bodies they would obey superposition, and he takes their not doing so as evidence that the universe is finite.}
}

